# Catppuccin Latte
# The one light scheme here — same hues as Mocha, inverted.
#
# Roles, darkest background to brightest accent. Every themed config is
# rendered from exactly these keys — see hypr/scripts/theme.sh.
name = Catppuccin Latte
mode = light

crust     = dce0e8
mantle    = e6e9ef
base      = eff1f5
surface0  = ccd0da
surface1  = bcc0cc
overlay   = 9ca0b0
subtext   = 5c5f77
text      = 4c4f69
rosewater = dc8a78
red       = d20f39
peach     = fe640b
yellow    = df8e1d
green     = 40a02b
teal      = 179299
sapphire  = 209fb5
blue      = 1e66f5
lavender  = 7287fd
mauve     = 8839ef
pink      = ea76cb
